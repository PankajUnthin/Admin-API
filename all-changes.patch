@@ -0,0 +1,30 @@
+import { readFileSync, existsSync } from 'node:fs'
+import { join, dirname } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const __dirname = dirname(fileURLToPath(import.meta.url))
+
+/**
+ * Load KEY=VALUE pairs from a .env file into process.env (does not overwrite
+ * vars already set in the shell). Supports simple quotes and # comments.
+ */
+export function loadEnvFile(filePath = join(__dirname, '..', '.env')) {
+  if (!existsSync(filePath)) return false
+  const text = readFileSync(filePath, 'utf8')
+  for (const line of text.split(/\r?\n/)) {
+    const trimmed = line.trim()
+    if (!trimmed || trimmed.startsWith('#')) continue
+    const eq = trimmed.indexOf('=')
+    if (eq <= 0) continue
+    const key = trimmed.slice(0, eq).trim()
+    let value = trimmed.slice(eq + 1).trim()
+    if (
+      (value.startsWith('"') && value.endsWith('"')) ||
+      (value.startsWith("'") && value.endsWith("'"))
+    ) {
+      value = value.slice(1, -1)
+    }
+    if (process.env[key] === undefined) process.env[key] = value
+  }
+  return true
+}
diff --git a/nikshay-enroll/lib/payload.js b/nikshay-enroll/lib/payload.js
new file mode 100644
index 0000000..4c45869
--- /dev/null
+++ b/nikshay-enroll/lib/payload.js
@@ -0,0 +1,112 @@
+/**
+ * Map one CSV row → AddIndiaTB JSON body.
+ *
+ * CSV column                → API field
+ * -------------------------   ------------------------------------------
+ * firstName                 → FirstName
+ * middleLastName            → LastName
+ * age                       → Age (+ DateOfBirth approx 01-01-{year-age})
+ * gender                    → Gender
+ * primaryPhone              → PrimaryPhone
+ * address                   → Address
+ * pincode                   → Pincode
+ * area                      → Area
+ * maritalStatus             → MaritalStatus
+ * occupation                → Occupation
+ * socioeconomicStatus       → SocioeconomicStatus
+ * symptoms (pipe-separated) → Symptom (comma-separated, trailing comma)
+ * hivStatus                 → HIVStatus
+ * typeOfCaseFinding         → TypeOfCaseFinding (Passive→full portal label)
+ * caste                     → caste (Other→Others)
+ * healthFacility (+ path)   → SelectedHierarchyId (resolved from master)
+ * village                   → ResidenceHierarchyId (+ ResidenceHierarchyAll)
+ * state/district/tu         → used to resolve hierarchy IDs only
+ */
+
+const CASE_FINDING = {
+  Passive: 'Passive (Routine programme)',
+  Active: 'Active (Community screening)'
+}
+
+const CASTE = {
+  SC: 'SC',
+  ST: 'ST',
+  Other: 'Others',
+  Others: 'Others'
+}
+
+function dobFromAge(age) {
+  const a = Number(age)
+  const year = new Date().getFullYear() - (Number.isFinite(a) ? a : 30)
+  return `01-01-${year}`
+}
+
+export { dobFromAge }
+
+function symptomsForApi(symptoms) {
+  const parts = (symptoms || 'Asymptomatic')
+    .split('|')
+    .map((s) => s.trim())
+    .filter(Boolean)
+  const joined = parts.join(',')
+  return joined.endsWith(',') ? joined : `${joined},`
+}
+
+/**
+ * @param {object} row CSV row
+ * @param {{ stateId: number, districtId: number, tuId: number, facilityId: number }} path
+ * @param {{ id: number, name: string }} village
+ * @param {boolean} isPossibleDuplicate
+ */
+export function buildPayload(row, path, village, isPossibleDuplicate) {
+  const today = new Date()
+  const dd = String(today.getDate()).padStart(2, '0')
+  const mm = String(today.getMonth() + 1).padStart(2, '0')
+  const yyyy = today.getFullYear()
+
+  return {
+    TypeOfPatient: 'IndiaTbPublic',
+    Stage: 'PRESUMPTIVE_OPEN',
+    RegistrationDate: `${dd}-${mm}-${yyyy}`,
+    SelectedHierarchyId: path.facilityId,
+    FirstName: row.firstName,
+    LastName: row.middleLastName,
+    FathersName: null,
+    Age: row.age,
+    Gender: row.gender,
+    PrimaryPhone: row.primaryPhone,
+    SecondaryPhone1: null,
+    SecondaryPhone2: null,
+    SecondaryPhone3: null,
+    Address: row.address,
+    Ward: null,
+    Taluka: null,
+    Landmark: null,
+    ResidenceHierarchyId: village.id,
+    ResidenceHierarchyAll: [1, path.stateId, path.districtId, path.tuId, village.id],
+    Pincode: row.pincode,
+    Area: row.area || 'Unknown',
+    MaritalStatus: row.maritalStatus || 'Unknown',
+    Occupation: row.occupation || 'Unknown',
+    SocioeconomicStatus: row.socioeconomicStatus || 'Unknown',
+    KeyPopulation: 'Not Applicable',
+    VaccinationDate: null,
+    Symptom: symptomsForApi(row.symptoms),
+    HIVStatus: row.hivStatus || 'Unknown',
+    ContactPersonPhone: null,
+    ContactPersonName: null,
+    ContactPersonAddress: null,
+    parentEpisodeId: null,
+    IsPossibleDuplicate: isPossibleDuplicate,
+    Source: null,
+    SourcePatientId: null,
+    TypeOfCaseFinding: CASE_FINDING[row.typeOfCaseFinding] || CASE_FINDING.Passive,
+    InformantId: null,
+    DateOfBirth: row.dateOfBirth || row.dob || dobFromAge(row.age),
+    FollowUpsDone: [],
+    TbWinReferenceId: null,
+    caste: CASTE[row.caste] || CASTE.Other,
+    healthId: null,
+    healthAddress: null
+  }
+}
diff --git a/nikshay-enroll/login-json.js b/nikshay-enroll/login-json.js
new file mode 100644
index 0000000..1bfef5c
--- /dev/null
+++ b/nikshay-enroll/login-json.js
@@ -0,0 +1,94 @@
+/**
+ * CLI for MMU-API (NikshayAuthClient): log in to Ni-kshay in a real browser and
+ * print the portal's session cookies as ONE JSON object on stdout, so Java can
+ * make the portal API calls itself.
+ *
+ *   NIKSHAY_USER=… NIKSHAY_PASS=… node login-json.js --env uat|production
+ *
+ * stdout on success:  { "origin": "https://beta.nikshay.in", "cookies": [ { "name", "value" }, … ] }
+ * stdout on failure:  { "error": "…", "rejected": true|false }   (exit code 1)
+ *   rejected = the portal refused the login (wrong username/password/captcha);
+ *   otherwise the portal couldn't be reached or answered unexpectedly.
+ *
+ * The cookies are a live login: stdout is read only by MMU-API and must never be
+ * logged. Progress goes to stderr and never includes the password or cookies.
+ */
+import { chromium } from 'playwright'
+import { ENV, DEFAULT_ENV } from './lib/config.js'
+import { login } from './lib/auth.js'
+
+function arg(name) {
+  const i = process.argv.indexOf(`--${name}`)
+  return i >= 0 ? process.argv[i + 1] : undefined
+}
+
+function fail(message, rejected) {
+  console.error(`login failed: ${message}`)
+  process.stdout.write(JSON.stringify({ error: message, rejected }))
+  process.exitCode = 1
+}
+
+const envName = arg('env') || process.env.NIKSHAY_ENV || DEFAULT_ENV
+const urls = ENV[envName]
+const username = process.env.NIKSHAY_USER
+const password = process.env.NIKSHAY_PASS
+
+if (!urls) {
+  fail(`unknown env "${envName}" (use uat or production)`, false)
+} else if (!username || !password) {
+  fail('NIKSHAY_USER and NIKSHAY_PASS are required', true)
+} else {
+  const headless = process.env.HEADLESS !== '0'
+  // Prefer system Google Chrome when present; PLAYWRIGHT_CHROME=0 uses Playwright's Chromium.
+  const useSystemChrome = process.env.PLAYWRIGHT_CHROME !== '0'
+  let browser
+  let page
+  try {
+    console.error(`login: ${envName} (${urls.origin}) user=${username}`)
+    browser = await chromium.launch({ headless, ...(useSystemChrome ? { channel: 'chrome' } : {}) })
+    const context = await browser.newContext()
+    page = await context.newPage()
+    page.setDefaultTimeout(30_000)
+    // The login page waits for jQuery/forge/md5 from public CDNs; loading it has taken
+    // 2-10s and sometimes more than 30s, so page loads get a longer limit.
+    page.setDefaultNavigationTimeout(90_000)
+    await login(page, username, password, urls.loginUrl, urls.homeUrlGlob)
+    if (!page.url().startsWith(urls.origin)) {
+      await page.goto(`${urls.origin}/Home`, { waitUntil: 'domcontentloaded' })
+    }
+    const cookies = (await context.cookies(urls.origin)).map((c) => ({ name: c.name, value: c.value }))
+    console.error(`login: ok (${cookies.length} cookies)`)
+    process.stdout.write(JSON.stringify({ origin: urls.origin, cookies }))
+  } catch (e) {
+    let message = (e && e.message ? e.message : String(e)).split('\n')[0]
+    // Right credentials, but Ni-kshay forces a password change first (first login or
+    // expired password). Never changed automatically: someone has to do it by hand.
+    if (page && new URL(page.url()).pathname.endsWith('/resetPassword')) {
+      message = 'Login failed: Ni-kshay requires a password change for this login. Log in to the portal by hand, ' +
+        'set a new password, then update it in the device configuration.'
+    }
+    // lib/auth.js throws "Login failed: …" when the portal refuses the login
+    fail(message + (page ? await whereItStopped(page) : ''), message.startsWith('Login failed'))
+  } finally {
+    if (browser) await browser.close().catch(() => undefined)
+  }
+}
+
+/**
+ * Where the browser ended up after a failed login: URL without the query, page
+ * title and the start of the visible text (e.g. a 403 or error page). Visible
+ * text never includes what was typed into the password field.
+ */
+async function whereItStopped(page) {
+  try {
+    const url = new URL(page.url())
+    const title = (await page.title().catch(() => '')).trim()
+    const text = ((await page.locator('body').innerText({ timeout: 3_000 }).catch(() => '')) || '')
+      .replace(/\s+/g, ' ')
+      .trim()
+      .slice(0, 300)
+    return ` [ended at ${url.origin}${url.pathname}; title "${title}"; page text: "${text}"]`
+  } catch {
+    return ''
+  }
+}
